# pgLite Environment Credentials - Example Template
# Copy this file to .env.local and fill in your actual credentials
# NEVER commit .env.local to version control!

# Load Test Environment
LOADTEST_HOST=your-loadtest-host.database.azure.com
LOADTEST_PORT=5432
LOADTEST_USER=postgres
LOADTEST_PASSWORD=your_loadtest_password
LOADTEST_DB=support

# Sandbox Environment
SANDBOX_HOST=your-sandbox-host.database.azure.com
SANDBOX_PORT=5432
SANDBOX_USER=postgres
SANDBOX_PASSWORD=your_sandbox_password
SANDBOX_DB=postgres

# Staging Environment
STAGING_HOST=your-staging-host.database.azure.com
STAGING_PORT=5432
STAGING_USER=postgres
STAGING_PASSWORD=your_staging_password
STAGING_DB=postgres

# VegaPay UAT Snapshot Environment
VEGAPAY_UAT_SNAPSHOT_HOST=your-uat-snapshot-host.rds.amazonaws.com
VEGAPAY_UAT_SNAPSHOT_PORT=5432
VEGAPAY_UAT_SNAPSHOT_USER=postgres
VEGAPAY_UAT_SNAPSHOT_PASSWORD=your_uat_snapshot_password
VEGAPAY_UAT_SNAPSHOT_DB=card_processor

# VegaPay UAT Environment
VEGAPAY_UAT_HOST=your-vegapay-uat-host.rds.amazonaws.com
VEGAPAY_UAT_PORT=5432
VEGAPAY_UAT_USER=postgres
VEGAPAY_UAT_PASSWORD=your_vegapay_uat_password
VEGAPAY_UAT_DB=card_processor

# Unity UAT Environment
UNITY_UAT_HOST=your-unity-uat-host.rds.amazonaws.com
UNITY_UAT_PORT=5432
UNITY_UAT_USER=postgres
UNITY_UAT_PASSWORD=your_unity_uat_password
UNITY_UAT_DB=card_processor

# Development Environment (Local)
DEV_HOST=localhost
DEV_PORT=5432
DEV_USER=postgres
DEV_PASSWORD=your_dev_password
DEV_DB=postgres